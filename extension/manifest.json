{
  "manifest_version": 3,
  "name": "YT Vision Notes — YouTube 截圖筆記",
  "short_name": "YT Vision Notes",
  "version": "0.1.0",
  "description": "在 YouTube 右側欄直接做截圖筆記：多圖連拍、裁切標註、分類與 #標籤，並同步到你的 Google Drive。",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["identity", "storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "1076400748035-5t6h8qv1sm21vp79o8tdii3uinemj383.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "YT Vision Notes", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shared/core.js", "shared/markdown.js", "shared/editor.js", "content.js"],
      "css": ["shared/editor.css", "content.css"],
      "run_at": "document_idle"
    }
  ]
}
